<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp">
  <TextView
      android:id="@+id/collapsed_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Radar · Fragoso · TESTE"
      style="@style/TextAppearance.Compat.Notification.Title" />
  <LinearLayout
      android:id="@+id/collapsed_lines"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:gravity="center_vertical|start"
      android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/collapsed_line_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/collapsed_badge_one_priority"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/radar_route_badge"
          android:paddingStart="5dp"
          android:paddingEnd="5dp"
          android:text="838"
          android:textColor="#212121"
          android:textSize="12sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/collapsed_badge_one_normal"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/radar_route_badge_normal"
          android:paddingStart="5dp"
          android:paddingEnd="5dp"
          android:textColor="#212121"
          android:textSize="12sp"
          android:textStyle="bold"
          android:visibility="gone" />
      <TextView
          android:id="@+id/collapsed_eta_one"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:maxLines="1"
          android:text="1 min"
          android:textSize="14sp"
          android:textStyle="bold"
          style="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>
    <TextView
        android:id="@+id/collapsed_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="·"
        style="@style/TextAppearance.Compat.Notification" />
    <LinearLayout
        android:id="@+id/collapsed_line_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          android:id="@+id/collapsed_badge_two_priority"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/radar_route_badge"
          android:paddingStart="5dp"
          android:paddingEnd="5dp"
          android:textColor="#212121"
          android:textSize="12sp"
          android:textStyle="bold"
          android:visibility="gone" />
      <TextView
          android:id="@+id/collapsed_badge_two_normal"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/radar_route_badge_normal"
          android:paddingStart="5dp"
          android:paddingEnd="5dp"
          android:text="855"
          android:textColor="#212121"
          android:textSize="12sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/collapsed_eta_two"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:maxLines="1"
          android:text="7 min"
          android:textSize="14sp"
          android:textStyle="bold"
          style="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>
  </LinearLayout>
  <TextView
      android:id="@+id/collapsed_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Sem previsões no momento"
      style="@style/TextAppearance.Compat.Notification"
      android:visibility="gone" />
</LinearLayout>
