{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDevelopmentDebug"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "radar": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDevelopmentRelease"
      },
      "env": {
        "APP_VARIANT": "radar",
        "EXPO_PUBLIC_RADAR_REMOTE_ENABLED": "true",
        "EXPO_PUBLIC_GPS_HUB_ROUTE": "/hub/gps",
        "EXPO_PUBLIC_API_BASE_URL": "https://noponto-api.shares.zrok.io",
        "EXPO_PUBLIC_API_FALLBACK_URL": "https://ununionized-suzanne-nonliterary.ngrok-free.dev",
        "EXPO_PUBLIC_RADAR_API_BASE_URL": "https://noponto-api.shares.zrok.io",
        "EXPO_PUBLIC_GPS_HUB_URL": "wss://noponto-api.shares.zrok.io/hub/gps"
      }
    },
    "nativeprobe": {
      "extends": "radar",
      "env": {
        "APP_VARIANT": "nativeprobe"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://noponto-api.shares.zrok.io",
        "EXPO_PUBLIC_API_FALLBACK_URL": "https://ununionized-suzanne-nonliterary.ngrok-free.dev",
        "EXPO_PUBLIC_RADAR_API_BASE_URL": "https://noponto-api.shares.zrok.io",
        "EXPO_PUBLIC_GPS_HUB_URL": "wss://noponto-api.shares.zrok.io/hub/gps"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleProductionRelease"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://noponto-api.shares.zrok.io",
        "EXPO_PUBLIC_API_FALLBACK_URL": "https://ununionized-suzanne-nonliterary.ngrok-free.dev",
        "EXPO_PUBLIC_RADAR_API_BASE_URL": "https://noponto-api.shares.zrok.io",
        "EXPO_PUBLIC_GPS_HUB_URL": "wss://noponto-api.shares.zrok.io/hub/gps"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
