<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BackendRoot Condition="'$(BackendRoot)' == ''">../../../../noponto-backend/NoPonto</BackendRoot>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Google.Protobuf"><HintPath>$(BackendRoot)/bin/Release/net9.0/Google.Protobuf.dll</HintPath></Reference>
    <Using Include="Microsoft.Extensions.Logging" />
    <Compile Include="Program.cs" />
    <Compile Include="TerminalPreflight.cs" />
    <Compile Include="$(BackendRoot)/2-Application/Services/GPS/GpsDatarioClient.cs" Link="Existing/GpsDatarioClient.cs" />
    <Compile Include="$(BackendRoot)/2-Application/Services/GPS/GpsDatarioClient.Bounded.cs" Link="Existing/GpsDatarioClient.Bounded.cs" />
    <Compile Include="$(BackendRoot)/2-Application/Services/GPS/GpsLeituraValidator.cs" Link="Existing/GpsLeituraValidator.cs" />
    <Compile Include="$(BackendRoot)/obj/Release/net9.0/2-Application/Services/GPS/Proto/GtfsRealtime.cs" Link="Existing/GtfsRealtime.cs" />
  </ItemGroup>
</Project>
